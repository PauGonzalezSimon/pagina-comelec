# ==========================================
# VARIABLES DE ENTORNO PARA RENDER
# ==========================================
# Copia este archivo y configura los valores en Render.com
# NO subas un archivo .env con valores reales a GitHub

# Token de API de Airtable (obtenerlo en: https://airtable.com/account)
AIRTABLE_TOKEN=tu_token_de_airtable_aqui

# ID de tu base de Airtable (ejemplo: appXXXXXXXXXXXXXX)
AIRTABLE_BASE_ID=tu_base_id_aqui

# Nombre de la tabla en Airtable
AIRTABLE_TABLE=Productos

# Puerto del servidor (Render lo configura automáticamente)
PORT=3000
